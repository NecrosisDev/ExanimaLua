+/// The offset an OVERLAPPED read names.
+fn overlapped_offset(o: LPOVERLAPPED) -> u64 {
+	let s = unsafe { *(*o).u.s() };
+	s.Offset as u64 | ((s.OffsetHigh as u64) << 32)
+}
+
+/// Marks an OVERLAPPED read as finished with `done` bytes (the handles the game reads are synchronous).
+unsafe fn complete_overlapped(o: LPOVERLAPPED, done: usize) {
+	unsafe {
+		(*o).Internal = 0;
+		(*o).InternalHigh = done;
+	}
+}
+
+/// Reads part of an unchanged entry from the original archive at `from`.
+unsafe fn read_original(read: TReadFile, h_file: HANDLE, from: u64, out: &mut [u8]) -> Option<usize> {
+	unsafe {
+		let mut high = (from >> 32) as i32;
+		SetFilePointer(h_file, from as u32 as i32, &mut high, FILE_BEGIN);
+		let mut got: DWORD = 0;
+		if read(h_file, out.as_mut_ptr() as _, out.len() as DWORD, &mut got, ptr::null_mut()) == 0 {
+			return None;
+		}
+		Some(got as usize)
+	}
+}
+
+/// Reads part of a mod's replacement or added file, `within` bytes from its start.
+fn read_mod_file(package: &std::path::Path, name: &str, within: u64, out: &mut [u8]) -> Option<usize> {
+	use std::io::{Seek, SeekFrom};
+	let stem = package.file_stem()?.to_string_lossy().into_owned();
+	let path = MOD_ENTRIES.get()?.get(&stem)?.get(name)?;
+	let mut file = fs::File::open(path).ok()?;
+	file.seek(SeekFrom::Start(within)).ok()?;
+	let mut done = 0;
+	while done < out.len() {
+		match file.read(&mut out[done..]) {
+			Ok(0) => break,
+			Ok(n) => done += n,
+			Err(_) => return None,
+		}
+	}
+	Some(done)
+}
