+fn fixture(root: &Path, id: &str, dll: Option<&Path>, enabled: bool, executable: Option<&Path>) {
+    let dir = root.join("mods").join(id);
+    std::fs::create_dir_all(&dir).unwrap();
+    std::fs::write(dir.join("manifest.toml"), "[plugin]\nname='Native fixture'\nversion='1'\n").unwrap();
+    if let Some(dll) = dll { std::fs::copy(dll, dir.join("fixture.dll")).unwrap(); }
+    let executable = executable.map(|p| format!("executable = {:?}\n", p.to_string_lossy().replace('\\', "/"))).unwrap_or_default();
+    std::fs::write(dir.join("config.toml"), format!(
+        "[plugin]\nid = {id:?}\nname = 'Startup fixture'\nversion = '1'\nsupported_versions = []\nurl = ''\nenabled = {enabled}\n{executable}[plugin.author]\nname = 'Fixture'\n"
+    )).unwrap();
+}
+
+fn entry(id: &str, enabled: bool) -> (emtk_core::plugin::Id, emtk_core::profile::LoadOrderEntry) {
+    (id.try_into().unwrap(), emtk_core::profile::LoadOrderEntry { enabled, priority: 0, ..Default::default() })
+}
+
+#[test]
+#[ignore = "Requires compiled owned fixture DLLs through EMTK_TEST_* environment variables"]
+fn profile_startup() {
+    let good = PathBuf::from(std::env::var_os("EMTK_TEST_PLUGIN_DLL").unwrap());
+    let missing = PathBuf::from(std::env::var_os("EMTK_TEST_MISSING_EXPORT_DLL").unwrap());
+    let decline = PathBuf::from(std::env::var_os("EMTK_TEST_DECLINE_DLL").unwrap());
+    let keyring = PathBuf::from(std::env::var_os("EMTK_TEST_KEYRING_DLL").unwrap());
+    let root = std::env::temp_dir().join(format!("emtk-startup-test-{}-{}", std::process::id(), std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()));
+    let local = Some(Path::new("fixture.dll"));
+    fixture(&root, "test.enabled", Some(&good), true, local);
+    fixture(&root, "test.profile-disabled", Some(&good), true, local);
+    fixture(&root, "test.config-disabled", Some(&good), false, local);
+    fixture(&root, "test.missing-export", Some(&missing), true, local);
+    fixture(&root, "test.declined", Some(&decline), true, local);
+    fixture(&root, "test.asset-only", None, true, None);
+    fixture(&root, "test.escape", None, true, Some(&good));
+    fixture(&root, "test.after-failure", Some(&good), true, local);
+    fixture(&root, "test.actual-native", Some(&keyring), true, local);
+    let order = vec![entry("test.profile-disabled", false), entry("test.config-disabled", true),
+        entry("test.missing-export", true), entry("test.declined", true), entry("test.escape", true),
+        entry("test.asset-only", true), entry("test.enabled", true), entry("test.after-failure", true),
+        entry("test.actual-native", true)];
+    load_profile_plugins(&root, &order);
+    for id in ["test.profile-disabled", "test.config-disabled", "test.missing-export", "test.escape", "test.asset-only"] {
+        assert!(PluginManager::get(id).is_none(), "Unexpected native load: {id}");
+    }
+    for id in ["test.enabled", "test.after-failure"] {
+        let state = PluginManager::get(id).unwrap();
+        let state = state.read().unwrap();
+        assert!(state.loaded && state.enabled);
+        unsafe {
+            let count = state.lib.get::<unsafe extern "C" fn() -> u32>(b"enable_count").unwrap();
+            assert_eq!(count(), 1);
+        }
+    }
+    for id in ["test.declined"] {
+        let state = PluginManager::get(id).unwrap();
+        let state = state.read().unwrap();
+        assert!(state.loaded && !state.enabled, "Unsupported host must be declined: {id}");
+    }
+    // The real Lua runtime can execute core Lua without exposing unavailable game APIs.
+    {
+        let state=PluginManager::get("test.actual-native").unwrap();
+        let state=state.read().unwrap();assert!(state.loaded && state.enabled);
+        unsafe {
+            let load=state.lib.get::<unsafe extern "C" fn(*const std::ffi::c_char,*const u8,usize,*const std::ffi::c_char)->bool>(b"load_script_addon").unwrap();
+            let id=std::ffi::CString::new("test.real-lua").unwrap();
+            let empty=std::ffi::CString::new("").unwrap();
+            let unavailable=std::ffi::CString::new("doors.unlock").unwrap();
+            let source=b"assert(api.version == 1 and io == nil)";
+            assert!(load(id.as_ptr(),source.as_ptr(),source.len(),empty.as_ptr()));
+            assert!(!load(id.as_ptr(),source.as_ptr(),source.len(),unavailable.as_ptr()));
+            let settings=std::ffi::CString::new("storage.settings").unwrap();
+            let settings_id=std::ffi::CString::new("test.settings").unwrap();
+            let increment=b"storage.set('count',storage.get('count',0)+1)";
+            assert!(load(settings_id.as_ptr(),increment.as_ptr(),increment.len(),settings.as_ptr()));
+            assert!(load(settings_id.as_ptr(),increment.as_ptr(),increment.len(),settings.as_ptr()));
+            let rejected=b"storage.set('count',999);error('settings rollback')";
+            assert!(!load(settings_id.as_ptr(),rejected.as_ptr(),rejected.len(),settings.as_ptr()));
+            let storage=PathBuf::from(std::env::var_os("LOCALAPPDATA").unwrap()).join("ExanimaLua/settings");
+            let mut current=None;let mut previous=None;
+            for first in std::fs::read_dir(storage).unwrap(){for second in std::fs::read_dir(first.unwrap().path()).unwrap(){
+                let directory=second.unwrap().path();
+                if directory.join("settings.json").is_file(){current=Some(std::fs::read_to_string(directory.join("settings.json")).unwrap());previous=Some(std::fs::read_to_string(directory.join("settings.previous.json")).unwrap());}
+            }}
+            assert!(current.unwrap().contains("\"count\":2"));assert!(previous.unwrap().contains("\"count\":1"));
+
+        }
+    }
+    // Profile scripts run only after their enabled native runtime is available.
+    fixture(&root, "test.lua-runtime", Some(&good), true, local);
+    for id in ["test.script-good", "test.script-disabled", "test.script-escape", "test.script-missing-runtime"] {
+        let directory=root.join("mods").join(id);
+        std::fs::create_dir_all(&directory).unwrap();
+        std::fs::write(directory.join("main.lua"), "-- startup fixture\nreturn true").unwrap();
+        let runtime=if id=="test.script-missing-runtime" {"test.unavailable"} else {"test.lua-runtime"};
+        let entry=if id=="test.script-escape" { good.to_string_lossy().replace('\\', "/") } else {"main.lua".to_string()};
+        std::fs::write(directory.join("manifest.toml"),format!("[plugin]\nname='Script'\nversion='1'\n[script]\nruntime={runtime:?}\nentry={entry:?}\nrequires=['events.item_use']\n")).unwrap();
+    }
+    let scripts=vec![entry("test.script-good",true),entry("test.script-disabled",false),entry("test.script-escape",true),
+        entry("test.script-missing-runtime",true),entry("test.lua-runtime",true)];
+    load_profile_plugins(&root,&scripts);
+    let state=PluginManager::get("test.lua-runtime").unwrap();
+    let state=state.read().unwrap();
+    unsafe {
+        let count=state.lib.get::<unsafe extern "C" fn()->u32>(b"script_count").unwrap();
+        assert_eq!(count(),1);
+    }
+    // The real provider consumes the declared module bundle, not a fixture stub.
+    let directory=root.join("mods/test.real-modules");std::fs::create_dir_all(directory.join("scripts")).unwrap();
+    std::fs::write(directory.join("scripts/main.lua"),"assert(require('util').value==42);assert(not api.has_capability('doors.unlock'));log.info('module loaded')").unwrap();
+    std::fs::write(directory.join("scripts/util.lua"),"return {value=42}").unwrap();
+    let manifest="[script]\nruntime='test.actual-native'\nentry='scripts/main.lua'\noptional=['doors.unlock','future.capability']\n[script.modules]\nutil='scripts/util.lua'\n";
+    std::fs::write(directory.join("manifest.toml"),manifest).unwrap();
+    let addon:emtk_core::plugin::Id="test.real-modules".try_into().unwrap();
+    assert!(load_profile_script(&root,&addon,&order).is_ok());
+    std::fs::write(root.join("outside.lua"),"return {value=42}").unwrap();
+    std::fs::write(directory.join("manifest.toml"),manifest.replace("scripts/util.lua","../../outside.lua")).unwrap();
+    assert!(load_profile_script(&root,&addon,&order).is_err());
+    std::fs::write(directory.join("manifest.toml"),manifest.replace("util=","'../bad'=")).unwrap();
+    assert!(load_profile_script(&root,&addon,&order).is_err());
+    std::fs::write(directory.join("manifest.toml"),manifest).unwrap();
+    std::fs::write(directory.join("scripts/util.lua"),vec![b' ';1024*1024]).unwrap();
+    assert!(load_profile_script(&root,&addon,&order).is_err(),"Aggregate source budget must include the entry");
+    let log=root.join("mods/test.actual-native/ScriptRuntime.log");
+    let messages=std::fs::read_to_string(log).unwrap();
+    assert!(messages.contains("Core Lua enabled")&&messages.contains("[test.real-modules]")&&messages.contains("module loaded"));
+    // Reload uses the selected profile and the same confined source loader.
+    let mut reload_order=order.clone();reload_order.push(entry("test.real-modules",true));
+    reload_order.push(entry("test.script-disabled",false));register_reload_providers(&root,&reload_order);
+    std::fs::write(directory.join("manifest.toml"),manifest).unwrap();
+    std::fs::write(directory.join("scripts/main.lua"),"assert(require('util').value==43);log.info('fresh reload')").unwrap();
+    std::fs::write(directory.join("scripts/util.lua"),"return {value=43}").unwrap();
+    let provider=std::ffi::CString::new("test.actual-native").unwrap();
+    let selected=std::ffi::CString::new("test.real-modules").unwrap();
+    let disabled=std::ffi::CString::new("test.script-disabled").unwrap();
+    let unknown=std::ffi::CString::new("test.not-selected").unwrap();
+    unsafe{
+        assert!(reload_scripts(provider.as_ptr(),selected.as_ptr()));
+        assert!(!reload_scripts(provider.as_ptr(),disabled.as_ptr()));
+        assert!(!reload_scripts(provider.as_ptr(),unknown.as_ptr()));
+        std::fs::write(directory.join("scripts/util.lua"),"error('bad reload')").unwrap();
+        assert!(!reload_scripts(provider.as_ptr(),selected.as_ptr()));
+        std::fs::write(directory.join("scripts/util.lua"),"return {value=43}").unwrap();
+        assert!(reload_scripts(provider.as_ptr(),selected.as_ptr()));
+    }
+    let messages=std::fs::read_to_string(root.join("mods/test.actual-native/ScriptRuntime.log")).unwrap();
+    assert!(messages.contains("fresh reload")&&messages.contains("bad reload"));
+    // Keep mapped fixture DLLs until test process exit; Windows cannot delete them now.
+}
