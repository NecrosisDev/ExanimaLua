+/// Load native logic only for mods enabled in the current profile, in its order.
+/// A missing config means an asset-only mod. A failed native mod does not prevent
+/// the next mod, or the game entry point, from running.
+pub fn load_profile_plugins(game_dir: &Path, order: &[(emtk::plugin::Id, emtk::profile::LoadOrderEntry)]) {
+	for (id, entry) in order {
+		if !entry.enabled { continue; }
+		if let Err(e) = load_profile_plugin(game_dir, id) {
+			error!("Native startup failed for {}: {:#}", id, e);
+		}
+	}
+    register_reload_providers(game_dir,order);
+	// Script runtimes are native providers; load them before any script addon.
+	for (id, entry) in order {
+		if !entry.enabled { continue; }
+		if let Err(e) = load_profile_script(game_dir, id, order) {
+			error!("Script startup failed for {}: {:#}", id, e);
+		}
+	}
+}
+
+type ProfileOrder=Vec<(emtk::plugin::Id,emtk::profile::LoadOrderEntry)>;
+struct ReloadProfile {directory:PathBuf,order:ProfileOrder}
+static RELOAD_PROFILES:std::sync::LazyLock<std::sync::RwLock<std::collections::HashMap<String,std::sync::Arc<ReloadProfile>>>>=
+    std::sync::LazyLock::new(||std::sync::RwLock::new(std::collections::HashMap::new()));
+type ReloadCallback=unsafe extern "C" fn(*const std::ffi::c_char,*const std::ffi::c_char)->bool;
+unsafe extern "C" fn reload_scripts(runtime:*const std::ffi::c_char,requested:*const std::ffi::c_char)->bool {
+    std::panic::catch_unwind(||{
+        if runtime.is_null()||requested.is_null(){return false;}
+        let runtime=unsafe{std::ffi::CStr::from_ptr(runtime)}.to_string_lossy();
+        let requested=unsafe{std::ffi::CStr::from_ptr(requested)}.to_string_lossy();
+        let profile={let profiles=RELOAD_PROFILES.read().unwrap();profiles.get(runtime.as_ref()).cloned()};
+        let Some(profile)=profile else{return false;};let mut found=false;let mut success=true;
+        for(id,entry)in &profile.order {
+            if !entry.enabled||(requested!="all"&&requested!=id.to_string()){continue;}
+            let manifest=profile.directory.join(id.plugin_dir()).join("manifest.toml");
+            let parsed=std::fs::read_to_string(manifest).ok().and_then(|text|toml::from_str::<ScriptManifest>(&text).ok());
+            let Some(ScriptManifest{script:Some(script)})=parsed else{continue;};
+            if script.runtime!=runtime{continue;}found=true;
+            if let Err(error)=load_profile_script_for(&profile.directory,id,&profile.order,Some(&runtime)){
+                error!("Script reload failed for {}: {:#}",id,error);success=false;
+            }
+        }
+        found&&success
+    }).unwrap_or(false)
+}
+fn register_reload_providers(game_dir:&Path,order:&[(emtk::plugin::Id,emtk::profile::LoadOrderEntry)]){
+    use std::ffi::CString;
+    let profile=std::sync::Arc::new(ReloadProfile{directory:game_dir.to_path_buf(),order:order.to_vec()});
+    for(id,entry)in order {
+        if !entry.enabled{continue;}let Some(state)=manager::PluginManager::get(&id.to_string()) else{continue;};
+        let state=state.read().unwrap();if !state.enabled{continue;}
+        unsafe{
+            let Ok(register)=state.lib.get::<unsafe extern "C" fn(ReloadCallback,*const std::ffi::c_char)->bool>(b"set_script_reload_callback") else{continue;};
+            let name=CString::new(id.to_string()).unwrap();
+            RELOAD_PROFILES.write().unwrap().insert(id.to_string(),profile.clone());
+            if !register(reload_scripts,name.as_ptr()){error!("Runtime declined reload provider: {}",id);}
+        }
+    }
+}
+
+#[derive(serde::Deserialize)]
+struct ScriptManifest { script: Option<ScriptEntry> }
+#[derive(serde::Deserialize)]
+struct ScriptEntry {
+    runtime: String, entry: String,
+    #[serde(default)] requires: Vec<String>,
+    #[serde(default)] optional: Vec<String>,
+    #[serde(default)] modules: std::collections::BTreeMap<String, String>,
+}
+#[repr(C)]
+struct ScriptModule { name: *const std::ffi::c_char, source: *const u8, size: usize }
+fn valid_module_name(name: &str) -> bool {
+    !name.is_empty() && name.len() <= 128 && !name.starts_with('.') && !name.ends_with('.') &&
+    !name.contains("..") && name.bytes().all(|c| c.is_ascii_alphanumeric() || c == b'_' || c == b'.')
+}
+fn read_script_file(directory: &Path, relative: &str, remaining: usize) -> Result<Vec<u8>> {
+    use std::io::Read;
+    let path=directory.join(relative).canonicalize()?;
+    ensure!(path.starts_with(directory) && path.is_file(), "Script file is outside its addon");
+    let mut source=Vec::new();
+    std::fs::File::open(path)?.take(remaining as u64+1).read_to_end(&mut source)?;
+    ensure!(source.len()<=remaining,"Script bundle exceeds 1 MiB");Ok(source)
+}
+
+fn load_profile_script(game_dir: &Path, id: &emtk::plugin::Id,
+    order: &[(emtk::plugin::Id, emtk::profile::LoadOrderEntry)]) -> Result<()> {
+    load_profile_script_for(game_dir,id,order,None)
+}
+fn load_profile_script_for(game_dir: &Path,id: &emtk::plugin::Id,
+    order: &[(emtk::plugin::Id,emtk::profile::LoadOrderEntry)],expected:Option<&str>)->Result<()> {
+    use std::ffi::CString;
+    let directory = game_dir.join(id.plugin_dir()).canonicalize()?;
+    let manifest = directory.join("manifest.toml");
+    if !manifest.is_file() { return Ok(()); }
+    let parsed: ScriptManifest = toml::from_str(&std::fs::read_to_string(manifest)?)?;
+    let Some(script) = parsed.script else { return Ok(()); };
+    ensure!(expected.is_none_or(|name|name==script.runtime),"Reload cannot change script runtime");
+    let runtime = emtk::plugin::Id::try_from(script.runtime.as_str())?;
+    ensure!(order.iter().any(|(id, entry)| id == &runtime && entry.enabled), "Required script runtime is not enabled: {}", runtime);
+    let root = game_dir.join(emtk::Instance::MODS_DIR).canonicalize()?;
+    ensure!(directory.starts_with(root), "Script addon directory is outside mods");
+    ensure!(script.modules.len()<=64,"Too many Lua modules");
+    let source=read_script_file(&directory,&script.entry,1024*1024)?;
+    let mut remaining=1024*1024-source.len();
+    let mut modules=Vec::new();
+    for (name,path) in &script.modules {
+        ensure!(valid_module_name(name),"Invalid Lua module name: {}",name);
+        let bytes=read_script_file(&directory,path,remaining)?;remaining-=bytes.len();
+        modules.push((CString::new(name.as_str())?,bytes));
+    }
+    ensure!(script.requires.iter().chain(script.optional.iter()).all(|name| !name.contains(',')), "Capability names cannot contain commas");
+    let required = CString::new(script.requires.join(","))?;
+    let optional = CString::new(script.optional.join(","))?;
+    let addon = CString::new(id.to_string())?;
+    let state = manager::PluginManager::get(&runtime.to_string()).ok_or_else(|| anyhow!("Script runtime was not loaded"))?;
+    let state = state.read().unwrap();
+    ensure!(state.enabled, "Script runtime declined activation");
+    unsafe {
+        let loaded=if modules.is_empty() && script.optional.is_empty() {
+            let load=state.lib.get::<unsafe extern "C" fn(*const std::ffi::c_char,*const u8,usize,*const std::ffi::c_char)->bool>(b"load_script_addon")?;
+            load(addon.as_ptr(),source.as_ptr(),source.len(),required.as_ptr())
+        }else{
+            let bundle:Vec<ScriptModule>=modules.iter().map(|(name,bytes)|ScriptModule{name:name.as_ptr(),source:bytes.as_ptr(),size:bytes.len()}).collect();
+            let load=state.lib.get::<unsafe extern "C" fn(*const std::ffi::c_char,*const u8,usize,*const std::ffi::c_char,*const std::ffi::c_char,*const ScriptModule,usize)->bool>(b"load_script_addon_v2")
+                .context("Runtime does not support declared Lua modules")?;
+            load(addon.as_ptr(),source.as_ptr(),source.len(),required.as_ptr(),optional.as_ptr(),bundle.as_ptr(),bundle.len())
+        };
+        ensure!(loaded,"Script runtime declined addon {} (see its diagnostics log)",id);
+    }
+    info!("Script addon accepted by runtime (may be pending): {}", id);
+    Ok(())
+}
+
+fn load_profile_plugin(game_dir: &Path, id: &emtk::plugin::Id) -> Result<()> {
+	let directory = game_dir.join(id.plugin_dir());
+	let config_path = directory.join("config.toml");
+	if !config_path.exists() { return Ok(()); }
+	let root = game_dir.join(emtk::Instance::MODS_DIR).canonicalize()?;
+	let directory = directory.canonicalize()?;
+	ensure!(directory.starts_with(root), "Plugin folder is outside mods");
+	let config = parser::parse_plugin_config(&std::fs::read_to_string(config_path)?)?;
+	ensure!(config.plugin.id.eq_ignore_ascii_case(&id.to_string()), "Config ID differs from the enabled profile entry");
+	if !config.plugin.enabled || config.plugin.executable.is_none() { return Ok(()); }
+	load_plugin(config::PluginInfo { config, path: directory.to_string_lossy().into_owned() })
+}
